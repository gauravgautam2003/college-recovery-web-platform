generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  password String
}

model College {
  id          String @id @default(cuid())
  name        String
  location    String
  description String
  rank        Int?
}
